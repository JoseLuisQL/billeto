generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Tabla de usuarios del sistema
/// Cada usuario puede pertenecer a múltiples workspaces vía Membership
model User {
  id                     String        @id @default(cuid())
  name                   String?
  email                  String        @unique
  emailVerified          DateTime?     @map("email_verified")
  image                  String?
  passwordHash           String?       @map("password_hash")
  avatar                 String?
  country                String?
  scheduledForDeletionAt DateTime?     @map("scheduled_for_deletion_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  auditLogs              AuditLog[]
  accounts               AuthAccount[]
  memberships            Membership[]
  sessions               Session[]

  @@map("users")
}

/// Cuentas de autenticación OAuth (NextAuth)
model AuthAccount {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

/// Sesiones de usuario (NextAuth)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Token de verificación de email (NextAuth)
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Workspace: unidad de aislamiento multi-tenant
/// Cada workspace agrupa cuentas, transacciones y configuraciones
model Workspace {
  id                    String                 @id @default(cuid())
  name                  String
  baseCurrency          String                 @default("PEN") @map("base_currency")
  country               String                 @default("PE")
  timezone              String                 @default("America/Lima")
  onboardingCompleted   Boolean                @default(false) @map("onboarding_completed")
  deletedAt             DateTime?              @map("deleted_at")
  deletedBy             String?                @map("deleted_by")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  accounts              Account[]
  auditLogs             AuditLog[]
  budgets               Budget[]
  categories            Category[]
  goals                 Goal[]
  goalContributions     GoalContribution[]
  integrations          Integration[]
  memberships           Membership[]
  recurringTransactions RecurringTransaction[]
  rules                 Rule[]
  subscription          Subscription?
  transactions          Transaction[]

  @@map("workspaces")
}

/// Membership: relación usuario <-> workspace con roles
model Membership {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  role        String    @default("owner")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("memberships")
}

/// Cuenta financiera del usuario (banco, efectivo, wallet)
model Account {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  name           String
  normalizedName String        @map("normalized_name")
  type           String        @default("cash")
  icon           String?
  accountNumber  String?       @map("account_number")
  currency       String        @default("PEN")
  initialBalance Decimal       @default(0) @map("initial_balance") @db.Decimal(15, 2)
  currentBalance Decimal       @default(0) @map("current_balance") @db.Decimal(15, 2)
  isFavorite     Boolean       @default(false) @map("is_favorite")
  favoriteRank   Int?          @map("favorite_rank")
  deletedAt      DateTime?     @map("deleted_at")
  deletedBy      String?       @map("deleted_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, isFavorite, favoriteRank])
  @@map("accounts")
}

/// Categoría de transacción (ingreso/gasto)
model Category {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  ownerUserId    String        @default("__SYSTEM__") @map("owner_user_id")
  name           String
  normalizedName String        @map("normalized_name")
  icon           String?
  color          String?
  type           String        @default("expense")
  deletedAt      DateTime?     @map("deleted_at")
  deletedBy      String?       @map("deleted_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  budgets        Budget[]
  transactions   Transaction[]

  @@unique([workspaceId, normalizedName, ownerUserId])
  @@index([workspaceId, ownerUserId])
  @@map("categories")
}

/// Transacción financiera (gasto, ingreso o transferencia)
model Transaction {
  id                    String             @id @default(cuid())
  workspaceId           String             @map("workspace_id")
  accountId             String?            @map("account_id")
  categoryId            String?            @map("category_id")
  amountOriginal        Decimal            @map("amount_original") @db.Decimal(15, 2)
  currencyOriginal      String             @map("currency_original")
  amountBase            Decimal            @map("amount_base") @db.Decimal(15, 2)
  baseCurrency          String             @map("base_currency")
  fxRateId              String?            @map("fx_rate_id")
  description           String
  type                  String             @default("expense")
  status                String             @default("posted")
  date                  DateTime           @default(now())
  source                String             @default("web")
  transferGroupId       String?            @map("transfer_group_id")
  transferPeerAccountId String?            @map("transfer_peer_account_id")
  requestId             String?            @map("request_id")
  deletedAt             DateTime?          @map("deleted_at")
  deletedBy             String?            @map("deleted_by")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  attachments           Attachment[]
  goalContributions     GoalContribution[]
  account               Account?           @relation(fields: [accountId], references: [id])
  category              Category?          @relation(fields: [categoryId], references: [id])
  fxRate                FXRate?            @relation(fields: [fxRateId], references: [id])
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, date(sort: Desc)])
  @@index([workspaceId, categoryId, date(sort: Desc)])
  @@index([workspaceId, accountId, date(sort: Desc)])
  @@index([workspaceId, transferGroupId])
  @@map("transactions")
}

/// Archivo adjunto a una transacción (imagen, PDF)
model Attachment {
  id            String      @id @default(cuid())
  transactionId String      @map("transaction_id")
  fileUrl       String      @map("file_url")
  fileType      String      @map("file_type")
  fileName      String?     @map("file_name")
  fileSizeBytes Int?        @map("file_size_bytes")
  createdAt     DateTime    @default(now()) @map("created_at")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

/// Tipo de cambio (FX Rate) para multi-moneda
model FXRate {
  id           String        @id @default(cuid())
  provider     String
  pair         String
  rate         Decimal       @db.Decimal(18, 8)
  fetchedAt    DateTime      @map("fetched_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  @@map("fx_rates")
}

/// Regla de categorización automática
model Rule {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  conditions  Json
  actions     Json
  status      String    @default("active")
  priority    Int       @default(0)
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("rules")
}

/// Transacción recurrente (suscripciones, pagos periódicos)
model RecurringTransaction {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  name           String
  description    String?
  amount         Decimal   @db.Decimal(15, 2)
  currency       String
  accountId      String?   @map("account_id")
  categoryId     String?   @map("category_id")
  type           String    @default("expense")
  frequency      String
  dayOfMonth     Int?      @map("day_of_month")
  status         String    @default("active")
  startDate      DateTime? @map("start_date")
  nextRunAt      DateTime  @map("next_run_at")
  lastRunAt      DateTime? @map("last_run_at")
  endCondition   String    @default("never") @map("end_condition")
  endDate        DateTime? @map("end_date")
  maxOccurrences Int?      @map("max_occurrences")
  executionCount Int       @default(0) @map("execution_count")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, nextRunAt])
  @@map("recurring_transactions")
}

/// Suscripciones populares predefinidas para selección rápida
model PopularSubscription {
  id        String  @id @default(cuid())
  name      String
  icon      String?
  color     String?
  price     Decimal @db.Decimal(15, 2)
  currency  String  @default("USD")
  category  String
  frequency String  @default("monthly")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("popular_subscriptions")
}

/// Presupuesto por categoría con alertas
model Budget {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  categoryId  String?   @map("category_id")
  name        String
  amount      Decimal   @db.Decimal(15, 2)
  currency    String
  period      String    @default("monthly")
  budgetType  String    @default("fixed") @map("budget_type")
  alertAt80   Boolean   @default(true) @map("alert_at_80")
  alertAt100  Boolean   @default(true) @map("alert_at_100")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  category    Category? @relation(fields: [categoryId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

/// Meta financiera (ahorro, viaje, deuda)
model Goal {
  id                  String             @id @default(cuid())
  workspaceId         String             @map("workspace_id")
  templateId          String?            @map("template_id")
  name                String
  targetAmount        Decimal            @map("target_amount") @db.Decimal(15, 2)
  currentAmount       Decimal            @default(0) @map("current_amount") @db.Decimal(15, 2)
  currency            String
  category            String?
  emoji               String?
  notes               String?
  deadline            DateTime?
  status              String             @default("active")
  deletedAt           DateTime?          @map("deleted_at")
  deletedBy           String?            @map("deleted_by")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  contributions       GoalContribution[]
  template            GoalTemplate?      @relation(fields: [templateId], references: [id])
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, deadline])
  @@index([workspaceId, templateId])
  @@map("goals")
}

/// Plantillas predefinidas para metas financieras
model GoalTemplate {
  id               String   @id @default(cuid())
  name             String
  normalizedName   String   @map("normalized_name")
  description      String
  category         String
  emoji            String?
  targetAmount     Decimal  @map("target_amount") @db.Decimal(15, 2)
  currency         String
  suggestedMonths  Int      @map("suggested_months")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  goals            Goal[]

  @@unique([normalizedName])
  @@index([category, sortOrder])
  @@map("goal_templates")
}

/// Historial de contribuciones a metas
model GoalContribution {
  id            String       @id @default(cuid())
  workspaceId   String       @map("workspace_id")
  goalId        String       @map("goal_id")
  transactionId String?      @map("transaction_id")
  amount        Decimal      @db.Decimal(15, 2)
  currency      String
  amountBase    Decimal      @map("amount_base") @db.Decimal(15, 2)
  sourceAmount  Decimal?     @map("source_amount") @db.Decimal(15, 2)
  sourceCurrency String?
  exchangeRate  Decimal?     @map("exchange_rate") @db.Decimal(18, 8)
  source        String       @default("transaction")
  note          String?
  createdAt     DateTime     @default(now()) @map("created_at")
  goal          Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, goalId, createdAt(sort: Desc)])
  @@index([workspaceId, transactionId])
  @@unique([goalId, transactionId])
  @@map("goal_contributions")
}

/// Integración externa (WhatsApp, Email, Webhook)
model Integration {
  id               String            @id @default(cuid())
  workspaceId      String            @map("workspace_id")
  type             String
  status           String            @default("pending")
  config           Json?
  waPhoneE164      String?           @map("wa_phone_e164")
  forwardingEmail  String?           @map("forwarding_email")
  webhookUrl       String?           @map("webhook_url")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        String?           @map("deleted_by")
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  whatsappMessages WhatsAppMessage[]

  @@index([workspaceId, type, status])
  @@map("integrations")
}

/// Mensaje de WhatsApp (para trazabilidad y procesamiento)
model WhatsAppMessage {
  id               String      @id @default(cuid())
  integrationId    String      @map("integration_id")
  waMessageId      String      @map("wa_message_id")
  direction        String
  processingStatus String      @default("received") @map("processing_status")
  contentType      String      @default("text") @map("content_type")
  rawPayload       Json?       @map("raw_payload")
  normalizedText   String?     @map("normalized_text")
  mediaUrl         String?     @map("media_url")
  createdAt        DateTime    @default(now()) @map("created_at")
  integration      Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, waMessageId])
  @@map("whatsapp_messages")
}

/// Registro de auditoría para trazabilidad
model AuditLog {
  id          String     @id @default(cuid())
  workspaceId String?    @map("workspace_id")
  actorId     String     @map("actor_id")
  actorType   String     @default("user") @map("actor_type")
  action      String
  entity      String
  entityId    String?    @map("entity_id")
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at")
  actor       User       @relation(fields: [actorId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Suscripción del workspace (plan Free/Pro/Premium)
model Subscription {
  id                     String    @id @default(cuid())
  workspaceId            String    @unique @map("workspace_id")
  planTier               String    @default("free") @map("plan_tier")
  status                 String    @default("active")
  currentPeriodStart     DateTime? @map("current_period_start")
  currentPeriodEnd       DateTime? @map("current_period_end")
  trialEndsAt            DateTime? @map("trial_ends_at")
  cancelledAt            DateTime? @map("cancelled_at")
  paymentProvider        String?   @map("payment_provider")
  externalSubscriptionId String?   @map("external_subscription_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
